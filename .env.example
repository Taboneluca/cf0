# Supabase Prompt Storage
PROMPTS_SUPABASE_URL=your_supabase_url
PROMPTS_SUPABASE_KEY=your_supabase_anon_key

# Backend Debug Settings (set to 1 to enable)
DEBUG_STREAMING=0
DEBUG_STREAMING_DELTA=0
DEBUG_STREAMING_TOOLS=0
DEBUG_FORMULA_PARSING=0

# Frontend Debug Settings (set to 1 to enable)
NEXT_PUBLIC_DEBUG_STREAMING=0
NEXT_PUBLIC_DEBUG_SSE=0
NEXT_PUBLIC_DEBUG_TOOLS=0

# Streaming Configuration & Timeout Management
SSE_STREAM_TIMEOUT=300
SSE_CONTENT_TIMEOUT=60  
SSE_HEARTBEAT_INTERVAL=15
SSE_ENABLE_COMPRESSION=1
SSE_ADAPTIVE_HEARTBEAT=1
SSE_DETAILED_ERRORS=1

# Debug Logging Frequency (higher = less frequent logging)
DEBUG_SSE_FREQUENCY=50
DEBUG_CONTENT_FREQUENCY=50
DEBUG_ORCHESTRATOR_FREQUENCY=25
DEBUG_CHUNK_FREQUENCY=100

# LLM Configuration
MAX_TOOL_ITERATIONS=50
MAX_RESPONSE_TOKENS=4000

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here  
GROQ_API_KEY=gsk_your-groq-key-here

# Monitoring
SENTRY_AUTH_TOKEN=your-sentry-token-here

# Supabase Production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@localhost:5432/postgres 