# Supabase Prompt Storage
PROMPTS_SUPABASE_URL=your_supabase_url
PROMPTS_SUPABASE_KEY=your_supabase_anon_key

# Backend Debug Settings (set to 1 to enable)
DEBUG_STREAMING=0
DEBUG_STREAMING_DELTA=0
DEBUG_STREAMING_TOOLS=0
DEBUG_FORMULA_PARSING=0

# Frontend Debug Settings (set to 1 to enable)
NEXT_PUBLIC_DEBUG_STREAMING=0
NEXT_PUBLIC_DEBUG_SSE=0
NEXT_PUBLIC_DEBUG_TOOLS=0

# LLM Configuration
MAX_TOOL_ITERATIONS=50
MAX_RESPONSE_TOKENS=4000

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here  
GROQ_API_KEY=gsk_your-groq-key-here

# Monitoring
SENTRY_AUTH_TOKEN=your-sentry-token-here

# Supabase Production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@localhost:5432/postgres 